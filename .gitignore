# claude_veniss — lives in <workspace>/claude_veniss/, symlinked from the root
# by setup.sh. The workspace folders are separate repos outside this one.

# Credentials — never commit (the real .env sits at the workspace root)
.env
.env.local
.env.*.local

# Per-machine Claude overrides (e.g. prod profile copied here)
.claude/settings.local.json

# Claude session logs — local only
docs/audit/*
!docs/audit/.gitkeep

# Python / OS noise
__pycache__/
.DS_Store

*.code-workspace