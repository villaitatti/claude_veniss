{
  "folders": [
    {
      "name": "VeNiss",
      "path": "../apps/VeNiss"
    },
    {
      "name": "metapolis-xdtiler",
      "path": "../metapolis-xdtiler"
    },
    {
      "name": "researchspace",
      "path": "../researchspace"
    },
    {
      "name": "claude_veniss",
      "path": "."
    }
  ],
  "settings": {
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.format.enable": false,
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.format.settings.url": ".eclipse/org.eclipse.jdt.core.prefs",
    "liveServer.settings.multiRootWorkspaceName": "VeNiss_ifc",
    "peacock.color": "#ff3d00"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Claude Code (workspace root)",
        "type": "shell",
        "command": "claude",
        "options": {
          "cwd": "${workspaceFolder:claude_veniss}/.."
        },
        "presentation": {
          "panel": "dedicated",
          "focus": true
        },
        "problemMatcher": []
      }
    ]
  }
}
