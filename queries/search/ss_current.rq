# CURRENT mechanism for Secondary Sources (title appellation + bds matchAllTerms). __TOKEN__ = RS lucene token
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bds: <http://www.bigdata.com/rdf/search#>
SELECT DISTINCT ?subject WHERE {
  ?subject a <https://veniss.net/ontology#Source_Secondary> .
  ?subject crm:P1_is_identified_by ?t . ?t a crm:E41_Appellation ;
        crm:P2_has_type <https://veniss.net/resource/type/title> ; rdfs:label ?label .
  SERVICE <http://www.bigdata.com/rdf/search#search> {
    ?label bds:search "__TOKEN__" ; bds:minRelevance "0.0" ; bds:matchAllTerms "true" . }
}
