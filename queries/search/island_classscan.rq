# RUNTIME search for Islands: appellations (proper names) and the rdfs:label slug.
# __TOKEN__ = RS lucene token ("certosa* 1564*"); in the template it is ?__token__.
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX crmpc: <http://www.cidoc-crm.org/crmpc/>
PREFIX frbroo: <http://iflastandards.info/ns/fr/frbr/frbroo/>
PREFIX vo: <https://veniss.net/ontology#>
PREFIX vt: <https://veniss.net/resource/type/>
SELECT ?subject WHERE {
  { SELECT ?subject (GROUP_CONCAT(DISTINCT LCASE(STR(?label)); separator=" | ") AS ?hay) WHERE {
      ?subject a vo:Island .
      { ?subject crm:P1_is_identified_by ?a . ?a rdfs:label ?label . FILTER NOT EXISTS { ?a crm:P2_has_type vt:search_term } }
      UNION { ?subject rdfs:label ?label }
    } GROUP BY ?subject }
  # Tokenize like Lucene: anything not a letter/digit (Lucene escapes, '*', punctuation) splits words.
  BIND(REPLACE(REPLACE(LCASE("__TOKEN__"), "[^\\p{L}\\p{N}]+", " "), "^ +| +$", "") AS ?words)
  BIND(CONCAT("^(?=.*", REPLACE(?words, " +", ")(?=.*"), ")") AS ?re)
  FILTER(REGEX(?hay, ?re, "s"))
}
