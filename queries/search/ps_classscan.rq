# RUNTIME search for Primary Sources: concat every displayed field of each source (title, island, year,
# archival path at any depth, carrier, location type, bib item, actors), then require every typed word.
# __TOKEN__ = RS lucene token ("certosa* 1564*"); in the template it is ?__token__.
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX crmpc: <http://www.cidoc-crm.org/crmpc/>
PREFIX vo: <https://veniss.net/ontology#>
PREFIX vt: <https://veniss.net/resource/type/>
SELECT ?subject WHERE {
  { SELECT ?subject (GROUP_CONCAT(DISTINCT LCASE(STR(?label)); separator=" | ") AS ?hay) WHERE {
      ?subject a vo:Source_Primary ;
               crm:P2_has_type <http://www.researchspace.org/resource/system/vocab/resource_type/Source_Primary> .
      { ?subject crm:P1_is_identified_by ?a . ?a crm:P2_has_type ?t ; rdfs:label ?label . VALUES ?t { vt:attributed_title vt:original_title } }
      UNION { ?subject rdfs:label ?label }
      UNION { ?subject vo:has_island ?isl . ?isl crm:P1_is_identified_by ?a . ?a rdfs:label ?label }
      UNION { ?subject crm:P108i_was_produced_by ?p . ?p crm:P4_has_time-span ?ts . ?ts crm:P170i_time_is_defined_by ?tp . ?tp crm:P2_has_type vt:time_primitive_year ; rdfs:label ?label }
      UNION { ?subject crm:P53_has_former_or_current_location ?loc . ?loc crm:P53_has_former_or_current_location ?ref . ?ref crm:P46i_forms_part_of* ?coll .
              { ?coll rdfs:label ?label } UNION { ?coll crm:P1_is_identified_by ?acr . ?acr crm:P2_has_type vt:acronym ; rdfs:label ?label } }
      UNION { ?subject crm:P53_has_former_or_current_location ?loc . ?loc crm:P1_is_identified_by ?cn .
              ?cn crm:P2_has_type <https://veniss.net/resource/vocab/information_carrier/name> ; rdfs:label ?label }
      UNION { ?subject crm:P53_has_former_or_current_location ?loc . ?loc crm:P2_has_type ?ct . ?ct rdfs:label ?label }
      UNION { ?subject crm:P53_has_former_or_current_location ?loc . ?loc crm:P46i_forms_part_of ?bib . ?bib rdfs:label ?label }
      UNION { ?subject crm:P108i_was_produced_by ?p . ?role crmpc:P01_has_domain ?p ; crmpc:P02_has_range ?actor .
              ?actor crm:P1_is_identified_by ?an . ?an rdfs:label ?label }
    } GROUP BY ?subject }
  # Tokenize like Lucene: anything not a letter/digit (Lucene escapes, '*', punctuation) splits words.
  BIND(REPLACE(REPLACE(LCASE("__TOKEN__"), "[^\\p{L}\\p{N}]+", " "), "^ +| +$", "") AS ?words)
  BIND(CONCAT("^(?=.*", REPLACE(?words, " +", ")(?=.*"), ")") AS ?re)
  FILTER(REGEX(?hay, ?re, "s"))
}
